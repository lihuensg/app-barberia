# ========================================
# AMBIENTE Y SECRETOS
# ========================================
NODE_ENV=development

# ========================================
# DATABASE (PostgreSQL)
# ========================================
# Local development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nazabarber

# Production (Neon - reemplazar con URL real)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ========================================
# JWT AUTHENTICATION
# ========================================
# Secreto JWT - cambiar por un valor seguro en cada entorno
JWT_SECRET=change_me_with_a_secure_secret_min_32_chars

# Duración del access token
JWT_EXPIRES_IN=15m

# Refresh token
REFRESH_TOKEN_SECRET=change_me_with_a_secure_refresh_secret_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=3000

# URLs permitidas para CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ========================================
# EMAIL - RESEND (Recuperación de contraseña)
# ========================================
RESEND_API_KEY=
MAIL_FROM=NazaBarber <onboarding@resend.dev>

# ========================================
# CLOUDINARY (Imágenes en la nube)
# ========================================
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nazabarber

# ========================================
# BUSINESS RULES (Reglas de Negocio)
# ========================================
MIN_BOOKING_NOTICE_MINUTES=10
CANCEL_MIN_HOURS=1

# ========================================
# ADMIN SEED (Producción)
# ========================================
ADMIN_EMAIL=admin@nazabarber.com
ADMIN_PASSWORD=
ADMIN_NOMBRE=Naza Barber
ADMIN_TELEFONO=3430000000
ADMIN_INSTAGRAM=@nazabarber
ADMIN_WHATSAPP=3430000000

# ========================================
# LOG Y DEBUG
# ========================================
# LOG_LEVEL=info
# DEBUG=false

# ========================================
# AUDITORÍA SELECTIVA
# ========================================
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=90
